# Kopieer dit bestand naar .env en vul de echte waarden in.
# .env staat in .gitignore — commit 'm nooit.
#
# SUPABASE_URL: te vinden in het Supabase-dashboard, Project Settings -> API.
# SUPABASE_SERVICE_ROLE_KEY: idem, "service_role" (NIET de "anon" key). Deze sleutel
# negeert Row Level Security, dus alleen gebruiken in server-side/lokale scripts —
# nooit in frontend-code of git.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
